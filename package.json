{
  "name": "realtor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Applicazione di statistica e stime immobiliari: gestione offline-first di schede immobiliari, distribuita come PWA e come app Android (Cordova).",
  "license": "MIT",
  "author": {
    "name": "Donato Pepe",
    "email": "dnt.ppe@gmail.com",
    "url": "https://github.com/donatopepe"
  },
  "homepage": "https://github.com/donatopepe/Realtor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donatopepe/Realtor.git"
  },
  "bugs": {
    "url": "https://github.com/donatopepe/Realtor/issues"
  },
  "keywords": [
    "cordova",
    "android",
    "pwa",
    "real-estate",
    "jquery-mobile",
    "offline-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.js",
    "serve:lan": "node scripts/serve.js --host 0.0.0.0",
    "icons": "bash scripts/make-icons.sh",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "server": "node server/src/server.js",
    "server:test": "node --test \"server/test/*.test.js\"",
    "docker:build": "docker build -f server/Dockerfile -t realtor-api .",
    "docker:run": "docker run --rm -p 3000:3000 -v realtor-data:/data realtor-api",
    "docs:check": "node scripts/docs-check.js",
    "scan:secrets": "node scripts/scan-secrets.js",
    "scan:secrets:history": "node scripts/scan-secrets.js --history",
    "prepare:android": "cordova platform add android",
    "prepare:ios": "node scripts/ios-prepare.js",
    "prepare:electron": "cordova platform add electron",
    "build:android": "cordova build android",
    "build:android:release": "cordova build android --release",
    "build:ios": "cordova build ios",
    "e2e": "playwright test",
    "sri:check": "node scripts/sri.js --check",
    "sri:update": "node scripts/sri.js --update",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:report": "npm audit --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-dialogs": "^2.0.2",
    "cordova-plugin-network-information": "^3.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-dialogs": {},
      "cordova-plugin-network-information": {}
    }
  }
}
